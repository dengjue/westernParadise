{
  "name": "western-paradise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "以西方极乐世界意象为灵感的数字园境共创原型（公开体验发布与运营待合规评估）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "walktest": "vitest run tests/walktest.test.ts",
    "test:watch": "vitest",
    "check:layers": "node scripts/check-layers.mjs",
    "check:content": "node scripts/check-content.mjs",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "verify:single": "node scripts/verify-single.mjs",
    "verify": "npm run typecheck && npm run check:layers && npm run check:content && npm run lint && npm run format:check && npm run test && npm run build && npm run build:single && npm run verify:single"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
